<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'pinpointer-ui-title'}"
    MinSize="300 250"
    Resizable="True">

    <BoxContainer Orientation="Vertical" VerticalExpand="True" Margin="5">
        <Label Text="{Loc 'pinpointer-ui-dna-saved-dnas'}" Margin="0 0 0 5"/>
        
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="SavedDnasList" Orientation="Vertical"/>
        </ScrollContainer>

        <PanelContainer StyleClasses="HighDivider" Margin="0 5 0 5"/>

        <Label Text="{Loc 'pinpointer-ui-dna-add-new'}" Margin="0 0 0 5"/>
        <BoxContainer Orientation="Horizontal">
            <LineEdit Name="DnaInput" 
                      PlaceHolder="{Loc 'pinpointer-ui-uplink-enter-dna'}" 
                      HorizontalExpand="True"/>
            <Button Name="AddButton" 
                    Text="{Loc 'pinpointer-ui-dna-add'}" 
                    StyleClasses="OpenBoth" 
                    Disabled="True"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>